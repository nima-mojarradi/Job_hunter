# Required. Token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Base URL of the remote-login mini app (job_hunter_remote_login_server.py).
# Use your current tunnel/domain, e.g. https://xxxx.trycloudflare.com/login
LOGIN_WEBAPP_URL=

# Optional: where per-user resume/session files live (default: resumes).
# JOB_HUNTER_SESSION_DIR=resumes

# Optional: max age in seconds for Telegram Mini App init data (default: 86400).
# TELEGRAM_INIT_DATA_MAX_AGE=86400

# Optional: close an idle remote-login browser session after N seconds (default: 600).
# JOB_HUNTER_SESSION_IDLE_TIMEOUT=600

# --- Public tunnel for the mini app (automatic, chosen by the watchdog) ---
# Priority: ngrok (if token set) -> serveo (default, no signup) -> cloudflared.
# The watchdog keeps the tunnel alive, updates LOGIN_WEBAPP_URL itself and
# re-registers the Telegram menu button, so you normally touch nothing here.

# Optional: ngrok free account token (https://dashboard.ngrok.com/get-started/your-authtoken).
# NGROK_AUTHTOKEN=

# Optional but recommended with ngrok: a reserved static domain, e.g. myapp.ngrok-free.app
# (free plan gives you one). Without it the ngrok URL changes on every restart.
# NGROK_DOMAIN=

# Serveo is the default provider: SSH reverse tunnel, no signup, no VPN needed.
# NOTE: anonymous sessions get a random URL like https://xxxx.serveousercontent.com
# that changes whenever the tunnel reconnects (the watchdog republishes it and
# re-registers the menu button automatically). Browsers also get a one-time
# "Serveo Browser Warning" page; tapping "Continue to Site" keeps the URL hash,
# so Telegram Mini-App init data survives.
# Set SERVEO_ENABLED=0 to disable serveo.
# SERVEO_ENABLED=1
# Optional: a custom subdomain works only after you register an SSH public key
# in the Serveo Console (https://console.serveo.net). Until then serveo ignores
# it and assigns a random URL.
# SERVEO_SUBDOMAIN=jobhunter
